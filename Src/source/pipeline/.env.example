# Pipeline configuration. Copy to .env and fill in.
#
#     cp Src/source/pipeline/.env.example Src/source/pipeline/.env
#
# .env is gitignored at every level of this repo - the key never gets
# committed. .env.example is tracked, so keep it free of real values.
#
# config.py loads .env automatically from three places, in this order:
#     <repo root>/.env
#     backend/.env
#     Src/source/pipeline/.env
# An exported shell variable always wins over a file, so you can override a
# single value for one run without editing anything.

# ---------------------------------------------------------------------------
# Required: the only secret here.
# ---------------------------------------------------------------------------
# Kimi is reachable two ways, and the key format tells you which you have:
#
#   key starts "sk-"     -> Moonshot direct.  PIPELINE_LLM_PROVIDER=openai
#   key starts "nvapi-"  -> NVIDIA NIM.       PIPELINE_LLM_PROVIDER=nvidia
#
# Sending one to the other endpoint fails with AuthenticationError, which
# reads like a bad key but is actually the wrong endpoint.

# NVIDIA NIM (build.nvidia.com) - key starts nvapi-
NVIDIA_API_KEY=nvapi-...

# Moonshot direct (platform.kimi.ai) - key starts sk-
# MOONSHOT_API_KEY=sk-...

# Claude instead? Set PIPELINE_LLM_PROVIDER=anthropic below.
# ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------------------------------------------------------
# Optional. Every one of these has a working default.
# ---------------------------------------------------------------------------

# nvidia    = Kimi on NVIDIA NIM        (nvapi- key)
# openai    = Kimi direct from Moonshot  (sk- key), or any OpenAI-compatible
#             endpoint including a local server
# anthropic = the Anthropic Messages API
# Switching provider also switches the default model and endpoint, so this is
# usually the only line you need to change.
PIPELINE_LLM_PROVIDER=nvidia

# Model id. Never hardcoded anywhere in the pipeline.
#   nvidia path    : moonshotai/kimi-k3 (default), moonshotai/kimi-k2.6
#   openai path    : kimi-k3 (default), kimi-k2.6, kimi-k2.7-code
#   anthropic path : claude-opus-5 (default)
# NVIDIA uses vendor-prefixed ids; Moonshot does not.
# PIPELINE_LLM_MODEL=moonshotai/kimi-k3

# Endpoint. Defaults to https://api.moonshot.ai/v1 on the openai path and to
# the SDK's own on the anthropic path. Override for a proxy or local server.
# PIPELINE_LLM_BASE_URL=

# low | medium | high | xhigh | max. Anthropic path only - kimi-k3 reasons
# unconditionally and the OpenAI-compatible surface has no field for it.
# PIPELINE_LLM_EFFORT=medium

# PIPELINE_LLM_MAX_TOKENS=8000

# kimi-k3 is a reasoning model and is slow - a single short call can take
# well over a minute. The 60s default is too low for it; raise this before
# running the examples.
# PIPELINE_LLM_TIMEOUT=300

# Retries on malformed JSON. 1 means one attempt plus one retry.
# PIPELINE_LLM_JSON_RETRIES=1

# ---------------------------------------------------------------------------
# The two experiment axes. Both also have command-line flags on
# run_examples.py, which is the easier way to sweep them.
# ---------------------------------------------------------------------------

# Feed the three model comments into the prompt.
# PIPELINE_INCLUDE_MODEL_COMMENTS=true

# Feed the extractor's spans into the prompt. false = "LLM leads": the
# extractor still runs every request, but only as an independent cross-check.
# PIPELINE_INCLUDE_EXTRACTED_SPANS=true
