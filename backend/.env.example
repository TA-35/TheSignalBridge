# Required. Flask uses this to sign session cookies and CSRF tokens - the
# app now refuses to start without it (see app/config.py). Generate a real
# one per environment, never reuse the same value across dev/prod, and never
# commit the actual value:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

DATABASE_URL=postgresql://user:password@localhost:5432/readtheroom
CORS_ORIGINS=http://localhost:5173

# --- Accounts (passkeys) ---------------------------------------------------
# The relying party is the registrable domain, so one passkey works on the
# site and against the API. It must match the domain the page is served
# from, or the browser refuses to create the passkey at all.
#   local:      localhost
#   production: thesignalbridge.com
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=BetweenWords
# Every origin the page may be served from, comma separated. Checked against
# the origin the authenticator signed.
#   production: https://thesignalbridge.com,https://www.thesignalbridge.com
WEBAUTHN_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# The session cookie is Secure by default, and a Secure cookie is dropped by
# the browser over plain http - which is what local dev runs on. Leave this
# false locally; never set it in production.
SESSION_COOKIE_SECURE=false
# Unset locally. In production the site and the API are different hosts under
# one registrable domain, so the cookie is set on the parent:
#   SESSION_COOKIE_DOMAIN=.thesignalbridge.com
# SESSION_COOKIE_DOMAIN=
