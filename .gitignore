# Environment
.env
.env.local
.env.production
*.env
!.env.example

# Python (backend)
backend/.venv/
backend/venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# Node (frontend has its own .gitignore; this covers other locations)
node_modules/
dist/
dist-ssr/

# OS / editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# DS pipeline - raw & intermediate data (never commit real data)
data/raw/*
data/staging/*
!data/raw/.gitkeep
!data/staging/.gitkeep

# Large processed files (keep small reference outputs, ignore bulk artifacts)
data/processed/*.csv
data/processed/*.tsv
data/processed/*.parquet
data/processed/*.jsonl
!data/processed/.gitkeep

# Common data science junk
*.ipynb_checkpoints/
.ipynb_checkpoints/

# SSH keys - never commit.
# The existing rules named specific filenames, which meant a key called
# anything else - ci_deploy_key, found untracked and stageable in this repo -
# slipped straight past them. These rules match by shape as well as by name.
documents
documents.pub
*.pem
*.key
id_ed25519*
id_rsa*
*deploy_key*
*_key
*_key.pub
# scp/ssh sometimes writes a file named after the host it was pointed at
ubuntu@*
*@*.*.*.*

# Flask instance folder (local sqlite db)
backend/instance/

# Root virtual environment
.venv/

# One-off deploy artifacts (e.g. `git archive` tarballs for manual scp)
*.tar

# Model weights. Ignore the big ones by name, not the whole models/ folder:
# the DistilBERT tone weights are ~265MB and stay out, but the NumPy
# politeness model in models/politeness_nn_iteration1/ is small and IS
# committed. Ignoring all of models/ silently hides a retrain's new files.
models/enron_tone_distilbert/
models/enron_tone_checkpoints/

# The question-conditioned circa variant: 64MB, and never reached in
# production because the adapter only selects it when a question is supplied
# and neither user flow collects one. Committed weights are permanent, so the
# one that does not run stays out. Regenerate it the day a flow starts asking
# "what are you replying to?":
#     python Src/source/pipeline/train_circa_weights.py question_answer
models/circa_nn_v2_iteration1/
models/**/*.bin
models/**/*.safetensors
models/**/*.pt
models/**/*.pth

# train_politeness_nn.py copies its input corpus next to the weights for
# provenance. The original is already tracked in data/Stanford_Politeness/,
# so the copy is 2.2MB of duplication - keep it local.
models/**/training_data_snapshot.csv

# Root virtual environment
.venv/
.venv311/

# Training runs (LoRA adapters, merged weights, GGUF) - GPU box only, never commit
runs/
*.gguf
