[Unit]
Description=TheSignalBridge pipeline inference service (gunicorn)
After=network.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__HOME__/inference
EnvironmentFile=__HOME__/inference/.env

# One worker on purpose. Each worker loads spaCy, scikit-learn and both model
# bundles independently - measured at ~505MB resident - so a second worker
# doubles the memory for no throughput gain. The bottleneck is the LLM call,
# which is I/O: threads serve concurrent requests without a second copy of
# the models.
#
# --timeout 120 because a single review can take 5-9 seconds and gunicorn's
# 30s default would kill a slow one mid-flight. --preload so the models load
# once before forking rather than once per worker.
ExecStart=__HOME__/inference/.venv/bin/gunicorn \
    --workers 1 --threads 4 --timeout 120 --preload \
    --bind 127.0.0.1:8100 \
    'Src.source.pipeline.service:create_service()'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
