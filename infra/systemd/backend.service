[Unit]
Description=ReadTheRoom Flask backend (gunicorn)
After=network.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/opt/read-the-room/backend
EnvironmentFile=/opt/read-the-room/backend/.env
ExecStart=/opt/read-the-room/backend/.venv/bin/gunicorn --workers 3 --bind 127.0.0.1:8000 wsgi:app
Restart=on-failure

[Install]
WantedBy=multi-user.target
